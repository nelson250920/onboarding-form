/* GENERATE PDF */
async function generatePDF() {
    const data = getFormData();
    const errors = collectErrors(data);
    if (errors.length > 0) { showErrorDrawer(errors); setTimeout(() => scrollToField(errors[0].fieldId), 250); return; }
    hideErrorDrawer();
    saveDraftSilent();
    document.getElementById("loaderOverlay").classList.add("visible");
    try {
        let response;
        try { response = await fetch(encodeURI(PDF_FILE_NAME), { cache: "no-store" }); }
        catch (e) { throw new Error("Could not load the PDF template."); }
        if (!response.ok) throw new Error("PDF template not found.");
        const buffer = await response.arrayBuffer();
        const pdfDoc = await PDFLib.PDFDocument.load(buffer);
        if (pdfDoc.getPageCount() !== 9) throw new Error("PDF must contain exactly 9 pages.");
        await applyPDFMapping(pdfDoc, data);
        const output = await pdfDoc.save();
        const blob = new Blob([output], { type: "application/pdf" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "Onboarding Documents - " + cleanFileName(data.name) + ".pdf";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1500);
        document.getElementById("loaderOverlay").classList.remove("visible");
        showStatus("PDF downloaded successfully. Next: print & sign, or upload to DigiLocker.", "success");
        fireConfetti();
    } catch (err) {
        document.getElementById("loaderOverlay").classList.remove("visible");
        showStatus("PDF generation failed: " + err.message, "error");
    }
}

function cleanFileName(name) {
    return String(name || "Candidate").replace(/[<>:"/\\|?*\x00-\x1F]/g, "_").replace(/\s+/g, " ").trim().substring(0, 80);
}

