/* VALIDATION */
function collectErrors(data) {
    const errors = [];
    const req = [
        ["name","Name",data.name],["fatherName","Father's Name",data.fatherName],
        ["dob","DOB",data.dob],["gender","Gender",data.gender],["maritalStatus","Marital Status",data.maritalStatus],
        ["religion","Religion",data.religion],["email","Email",data.email],["mobile","Mobile",data.mobile],
        ["doj","DOJ",data.doj],["employmentStatus","Employment Status",data.employmentStatus],
        ["internationalWorker","International Worker",data.internationalWorker],
        ["bankAccount","Bank Account",data.bankAccount],["ifsc","IFSC",data.ifsc],
        ["aadhaar","Aadhaar",data.aadhaar],["pan","PAN",data.pan],
        ["epfMember","EPF membership",data.epfMember],["epsMember","EPS membership",data.epsMember],
        ["uan","UAN",data.uan],["withdrawEPF","Withdrawn EPF",data.withdrawEPF],["withdrawEPS","Withdrawn EPS",data.withdrawEPS],
        ["permanentAddress","Address",data.permanentAddress],["city","City",data.city],["district","District",data.district],
        ["state","State",data.state],["pincode","Pincode",data.pincode],
        ["place","Place",data.place],["declarationDate","Declaration Date",data.declarationDate]
    ];
    req.forEach(([id, label, v]) => { if (!v) errors.push({ fieldId: id, label }); });

    const spouseReq = ["Married","Widow","Widower","Divorcee"].includes(data.maritalStatus);
    if (spouseReq && !data.spouseName) errors.push({ fieldId: "spouseName", label: "Spouse's Name" });

    if (data.mobile && !/^\d{10}$/.test(data.mobile)) errors.push({ fieldId: "mobile", label: "Mobile (10 digits)" });
    if (data.aadhaar && !/^\d{12}$/.test(data.aadhaar)) errors.push({ fieldId: "aadhaar", label: "Aadhaar (12 digits)" });
    if (data.uan && !/^\d{12}$/.test(data.uan)) errors.push({ fieldId: "uan", label: "UAN (12 digits)" });
    if (data.pincode && !/^\d{6}$/.test(data.pincode)) errors.push({ fieldId: "pincode", label: "Pincode (6 digits)" });
    if (data.pan && !/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(data.pan)) errors.push({ fieldId: "pan", label: "PAN invalid" });
    if (data.ifsc && !/^[A-Z]{4}0[A-Z0-9]{6}$/.test(data.ifsc)) errors.push({ fieldId: "ifsc", label: "IFSC invalid" });

    if (data.employmentStatus === "Experienced") {
        if (!data.previousCompany) errors.push({ fieldId: "previousCompany", label: "Previous Company" });
        if (!data.previousDOJ) errors.push({ fieldId: "previousDOJ", label: "Previous DOJ" });
        if (!data.previousDOE) errors.push({ fieldId: "previousDOE", label: "Previous DOE" });
    }

    const clean = data.nominees.filter((n, i) => i === 0 || !(!n.name && !n.address && !n.relation && !n.aadhaar && !n.dob && !n.percentage));
    if (clean.length === 0) errors.push({ fieldId: "nominee1_name", label: "At least one Nominee" });
    else {
        let total = 0;
        clean.forEach(function (n, i) {
            const num = i + 1;
            if (!n.name) errors.push({ fieldId: "nominee"+num+"_name", label: "Nominee "+num+" Name" });
            if (!n.address) errors.push({ fieldId: "nominee"+num+"_address", label: "Nominee "+num+" Address" });
            if (!n.relation) errors.push({ fieldId: "nominee"+num+"_relation", label: "Nominee "+num+" Relation" });
            if (!n.aadhaar) errors.push({ fieldId: "nominee"+num+"_aadhaar", label: "Nominee "+num+" Aadhaar" });
            else if (!/^\d{12}$/.test(n.aadhaar)) errors.push({ fieldId: "nominee"+num+"_aadhaar", label: "Nominee "+num+" Aadhaar (12)" });
            if (!n.dob) errors.push({ fieldId: "nominee"+num+"_dob", label: "Nominee "+num+" DOB" });
            if (!n.percentage) errors.push({ fieldId: "nominee"+num+"_percentage", label: "Nominee "+num+" %" });
            total += Number(n.percentage) || 0;
        });
        if (total !== 100 && clean.every(n => n.percentage)) errors.push({ fieldId: "nominee1_percentage", label: "Shares must total 100%" });
    }

    if (!data.declaration) errors.push({ fieldId: "decl1", label: "Declaration" });
    return errors;
}

function showErrorDrawer(errors) {
    missingFields = errors;
    const drawer = document.getElementById("errorDrawer");
    const body = document.getElementById("errorDrawerBody");
    document.getElementById("errorCount").textContent = errors.length === 1 ? "1 field needs attention" : errors.length + " fields need attention";
    body.innerHTML = "";
    errors.forEach(function (err, i) {
        const btn = document.createElement("button");
        btn.className = "error-item";
        btn.type = "button";
        btn.innerHTML = `<span class="error-item-num">${i+1}</span><span class="error-item-label">${err.label}</span><span class="error-item-arrow">→</span>`;
        btn.addEventListener("click", () => scrollToField(err.fieldId));
        body.appendChild(btn);
    });
    drawer.classList.add("visible");
    errors.forEach(function (err) {
        const el = document.getElementById(err.fieldId);
        if (!el) return;
        const w = el.closest(".field") || el.closest(".declaration");
        if (w) {
            w.classList.remove("field-valid");
            w.classList.add(w.classList.contains("declaration") ? "declaration-invalid" : "field-invalid");
        }
    });
}

function hideErrorDrawer() { document.getElementById("errorDrawer").classList.remove("visible"); }

function scrollToField(id) {
    const el = document.getElementById(id);
    if (!el) return;
    const target = el.closest(".field") || el.closest(".declaration") || el;
    target.scrollIntoView({ behavior: "smooth", block: "center" });
    setTimeout(() => { if (el.focus) el.focus({ preventScroll: true }); }, 400);
}

function focusFirstError() {
    if (missingFields.length) { scrollToField(missingFields[0].fieldId); hideErrorDrawer(); }
}

function updateFieldState(field) {
    if (!field || !field.closest) return;
    const w = field.closest(".field");
    if (!w) return;
    if (field.closest(".hidden")) { w.classList.remove("field-valid", "field-invalid"); return; }
    const v = (field.value || "").trim();
    if (v) { w.classList.remove("field-invalid"); w.classList.add("field-valid"); }
    else if (field.required && field.dataset.touched === "true") { w.classList.add("field-invalid"); w.classList.remove("field-valid"); }
    else { w.classList.remove("field-valid", "field-invalid"); }
}

function attachValidationListeners(container) {
    const scope = container || document;
    scope.querySelectorAll("input, select, textarea").forEach(function (f) {
        if (f.dataset.tr === "true") return;
        f.dataset.tr = "true";
        f.addEventListener("blur", function () { f.dataset.touched = "true"; updateFieldState(f); });
        f.addEventListener("input", function () { updateFieldState(f); updateProgress(); });
        f.addEventListener("change", function () { f.dataset.touched = "true"; updateFieldState(f); updateProgress(); });
    });
    scope.querySelectorAll('input[name="declaration"]').forEach(function (r) {
        if (r.dataset.tr === "true") return;
        r.dataset.tr = "true";
        r.addEventListener("change", function () {
            document.querySelectorAll(".declaration").forEach(d => d.classList.remove("declaration-invalid"));
            updateProgress();
        });
    });
}

function updateProgress() {
    const req = Array.from(document.querySelectorAll("input[required], select[required], textarea[required]")).filter(f => !f.closest(".hidden"));
    const filled = req.filter(f => (f.value || "").trim().length > 0).length;
    document.getElementById("navProgressText").textContent = filled + " / " + req.length;
}

