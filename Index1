    </div>
</div>

<h2 class="section-title" id="personal" data-split="chars" data-delay="35" data-i18n="personalTitle">Personal Details</h2>
<p class="section-subtitle" data-split="words" data-delay="25" data-i18n="personalSubtitle">Please provide your personal and employment information as per your official documents.</p>

<div class="grid">
    <div class="field"><label><span data-i18n="name">Name as per Aadhaar</span> <span class="required">*</span></label><input type="text" id="name" required></div>
    <div class="field"><label><span data-i18n="fatherName">Father's Name</span> <span class="required">*</span></label><input type="text" id="fatherName" required></div>
    <div class="field"><label><span data-i18n="spouseName">Spouse's Name</span> <span id="spouseRequired" class="required">*</span></label><input type="text" id="spouseName"></div>
    <div class="field"><label><span data-i18n="dob">Date of Birth as per Aadhaar</span> <span class="required">*</span></label><input type="date" id="dob" required></div>
    <div class="field"><label><span data-i18n="gender">Gender</span> <span class="required">*</span></label><select id="gender" required><option value="">Select</option><option>Male</option><option>Female</option><option>Transgender</option></select></div>
    <div class="field"><label><span data-i18n="maritalStatus">Marital Status</span> <span class="required">*</span></label><select id="maritalStatus" onchange="maritalStatusChanged()" required><option value="">Select</option><option>Married</option><option>Unmarried</option><option>Widow</option><option>Widower</option><option>Divorcee</option></select></div>
    <div class="field"><label><span data-i18n="religion">Religion</span> <span class="required">*</span></label><input type="text" id="religion" required></div>
    <div class="field"><label><span data-i18n="email">Email ID</span> <span class="required">*</span></label><input type="email" id="email" required></div>
    <div class="field"><label><span data-i18n="mobile">Mobile Number</span> <span class="required">*</span></label><input type="text" id="mobile" inputmode="numeric" maxlength="10" oninput="digitsOnly(this)" required></div>
    <div class="field"><label><span data-i18n="doj">Date of Joining (DOJ)</span> <span class="required">*</span></label><input type="date" id="doj" required></div>
    <div class="field"><label><span data-i18n="employmentStatus">Employment Status</span> <span class="required">*</span></label><select id="employmentStatus" onchange="employmentChanged()" required><option value="">Select</option><option>Fresher</option><option>Experienced</option></select></div>
    <div class="field"><label><span data-i18n="internationalWorker">International Worker</span> <span class="required">*</span></label><select id="internationalWorker" required><option value="">Select</option><option>Yes</option><option>No</option></select></div>
</div>

<div id="previousEmployment" class="hidden">
    <h2 class="section-title" data-split="chars" data-delay="35" data-i18n="previousEmployment">Previous Employment Details</h2>
    <p class="section-subtitle" data-split="words" data-delay="25">These details are required only for experienced employees.</p>
    <div class="grid">
        <div class="field"><label>Previous Company Name <span class="required">*</span></label><input type="text" id="previousCompany"></div>
        <div class="field"><label>Previous DOJ <span class="required">*</span></label><input type="date" id="previousDOJ"></div>
        <div class="field"><label>Previous DOE <span class="required">*</span></label><input type="date" id="previousDOE"></div>
    </div>
</div>

<h2 class="section-title" id="kyc" data-split="chars" data-delay="35" data-i18n="kycTitle">KYC / Bank Details</h2>
<p class="section-subtitle" data-split="words" data-delay="25">Enter your KYC and bank information carefully.</p>
<div class="grid">
    <div class="field"><label><span data-i18n="bankAccount">Bank Account Number</span> <span class="required">*</span></label><input type="text" id="bankAccount" inputmode="numeric" oninput="digitsOnly(this)" required></div>
    <div class="field"><label><span data-i18n="ifsc">IFSC Code</span> <span class="required">*</span></label><input type="text" id="ifsc" maxlength="11" required></div>
    <div class="field"><label><span data-i18n="aadhaar">Aadhaar Number</span> <span class="required">*</span></label><input type="text" id="aadhaar" inputmode="numeric" maxlength="12" oninput="digitsOnly(this)" required></div>
    <div class="field"><label><span data-i18n="pan">PAN Number</span> <span class="required">*</span></label><input type="text" id="pan" maxlength="10" oninput="this.value=this.value.toUpperCase()" required></div>
</div>

<h2 class="section-title" data-split="chars" data-delay="35" data-i18n="pfTitle">EPF / EPS / UAN Details</h2>
<div class="grid">
    <div class="field"><label>Whether earlier a member of EPF Scheme, 1952 <span class="required">*</span></label><select id="epfMember" required><option value="">Select</option><option>Yes</option><option>No</option></select></div>
    <div class="field"><label>Whether earlier a member of EPS, 1995 <span class="required">*</span></label><select id="epsMember" required><option value="">Select</option><option>Yes</option><option>No</option></select></div>
    <div class="field"><label>Universal Account Number (UAN) <span class="required">*</span></label><input type="text" id="uan" inputmode="numeric" maxlength="12" oninput="digitsOnly(this)" required></div>
    <div class="field"><label>Withdrawn Previous EPF Fund <span class="required">*</span></label><select id="withdrawEPF" required><option value="">Select</option><option>Yes</option><option>No</option></select></div>
    <div class="field"><label>Withdrawn Previous EPS Fund <span class="required">*</span></label><select id="withdrawEPS" required><option value="">Select</option><option>Yes</option><option>No</option></select></div>
</div>

<h2 class="section-title" data-split="chars" data-delay="35" data-i18n="addressTitle">Permanent Address</h2>
<div class="grid">
