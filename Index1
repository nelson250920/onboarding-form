}

/* GHOST CURSOR */
(function ghostCursor() {
    if (prefersReducedMotion) return;
    const canvas = document.getElementById("splashCanvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let w, h;
    function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; }
    resize();
    window.addEventListener("resize", resize);

    const trail = [];
    const MAX_TRAIL = 45;
    let mx = -100, my = -100;
    let lastMoveTime = 0;

    window.addEventListener("pointermove", function (e) {
        mx = e.clientX;
        my = e.clientY;
        lastMoveTime = performance.now();
    });

    function tick(now) {
        ctx.clearRect(0, 0, w, h);

        const idle = now - lastMoveTime;
        if (idle < 1000 && mx > 0) {
            trail.push({ x: mx, y: my, born: now });
        }
        while (trail.length > MAX_TRAIL) trail.shift();

        // Outer bloom
        for (let i = 0; i < trail.length; i++) {
            const p = trail[i];
            const age = now - p.born;
            const life = Math.max(0, 1 - age / 1500);
            if (life <= 0) continue;
            const size = 60 * (1 - i / trail.length) * life;
            const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, size);
            grad.addColorStop(0, "rgba(255, 100, 100, " + (0.18 * life) + ")");
            grad.addColorStop(0.5, "rgba(192, 0, 0, " + (0.08 * life) + ")");
            grad.addColorStop(1, "rgba(192, 0, 0, 0)");
            ctx.fillStyle = grad;
            ctx.fillRect(p.x - size, p.y - size, size * 2, size * 2);
        }

        // Bright core
        for (let i = 0; i < trail.length; i++) {
            const p = trail[i];
            const age = now - p.born;
            const life = Math.max(0, 1 - age / 1500);
            if (life <= 0) continue;
            const fade = (i / trail.length);
            const r = 3 + fade * 4;
            ctx.beginPath();
            ctx.arc(p.x, p.y, r * life, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(255, " + Math.round(120 + fade * 100) + ", 120, " + (life * 0.7 * (1 - fade * 0.5)) + ")";
            ctx.fill();
        }

        // Remove dead particles
        while (trail.length && now - trail[0].born > 1500) trail.shift();

        requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
})();

