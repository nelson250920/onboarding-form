<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Red — Onboarding Documents</title>
<meta name="theme-color" content="#1a0a0c">
<link rel="icon" href="https://teamred.uknowva.com/images/logo/screenshot_3.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Lexend:wght@600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --red: #c00000;
    --red-dark: #7a0000;
    --red-deep: #4a0000;
    --red-bright: #ff2b2b;
    --red-tint: #fdf1f1;
    --red-tint-2: #fce4e4;
    --ink: #16100f;
    --ink-soft: #55494a;
    --line: #e7dede;
    --canvas: #1a0a0c;
    --green: #16a34a;
    --font-display: "Lexend", system-ui, sans-serif;
    --font-body: "Manrope", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
}

html { scroll-behavior: smooth; scroll-padding-top: 110px; }

body {
    font-family: var(--font-body);
    background: var(--canvas);
    color: var(--ink);
    font-size: 10.5pt;
    line-height: 1.5;
    overflow-x: hidden;
    min-height: 100vh;
}

::selection { background: var(--red); color: white; }
::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: #1a0a0a; }
::-webkit-scrollbar-thumb { background: var(--red); border-radius: 10px; border: 2px solid #1a0a0a; }

/* ═══ DARK RED BG (lighter, warmer) ═══ */
.bg-scene {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
        radial-gradient(1400px 900px at 50% -10%, rgba(255, 40, 40, 0.38) 0%, transparent 60%),
        radial-gradient(1100px 800px at 110% 110%, rgba(192, 0, 0, 0.42) 0%, transparent 60%),
        radial-gradient(900px 700px at -10% 60%, rgba(122, 0, 0, 0.48) 0%, transparent 55%),
        radial-gradient(1400px 1000px at 50% 50%, rgba(122, 0, 0, 0.3) 0%, transparent 70%),
        linear-gradient(180deg, #1a0a0c 0%, #2a0e10 45%, #1a0a0c 100%);
}

.bg-scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(0deg,
        rgba(255, 100, 100, 0.025) 0px,
        rgba(255, 100, 100, 0.025) 1px,
        transparent 1px, transparent 3px);
    mix-blend-mode: overlay;
    opacity: 0.7;
}

.bg-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.9 0 0 0 0 0.2 0 0 0 0 0.2 0 0 0 0.4 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    opacity: 0.15;
    mix-blend-mode: overlay;
}

/* ═══ SPLIT-FLAP ═══ */
.split-chars { display: inline-flex; flex-wrap: wrap; perspective: 500px; vertical-align: baseline; }
.split-char { display: inline-block; backface-visibility: hidden; white-space: pre; }
.split-char[data-space="1"] { width: 0.32em; }
.split-chars.animate .split-char { animation: sfFlip 0.72s cubic-bezier(0.34, 1.4, 0.64, 1) backwards; }
@keyframes sfFlip {
    from { opacity: 0; transform: rotateX(-90deg) translateY(-4px); }
    to { opacity: 1; transform: rotateX(0deg) translateY(0); }
}
.split-words { display: inline; }
.split-word { display: inline-block; white-space: nowrap; }
.split-words.animate .split-word { animation: sfWordIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
@keyframes sfWordIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
}
.split-lines .split-line { display: block; }
.split-lines.animate .split-line { animation: sfLineIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
@keyframes sfLineIn {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
}

/* ═══ SHINY TEXT on section-title characters ═══ */
.section-title .split-char:not([data-space="1"]) {
    background: linear-gradient(120deg,
        #7a0000 0%, var(--red) 20%, var(--red-bright) 42%,
        #ffb8b8 50%, var(--red-bright) 58%, var(--red) 80%, #7a0000 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation:
        sfFlip 0.72s cubic-bezier(0.34, 1.4, 0.64, 1) backwards,
        shinySweep 3.2s linear infinite;
}

@keyframes shinySweep {
    from { background-position: 200% 50%; }
    to { background-position: -100% 50%; }
}

/* ═══ GHOST CURSOR ═══ */
#splashCanvas {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.85;
}

@media (prefers-reduced-motion: reduce) {
    .split-char, .split-word, .split-line {
        opacity: 1 !important; transform: none !important; animation: none !important;
    }
    .section-title .split-char:not([data-space="1"]) {
        background: none; -webkit-text-fill-color: var(--red);
    }
    #splashCanvas { display: none; }
}

/* ═══ NAV (high contrast) ═══ */
.pill-nav {
    position: sticky;
    top: 16px;
    z-index: 60;
    margin: 16px auto 0;
    max-width: 920px;
    padding: 0 15px;
    animation: navIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes navIn { from { opacity: 0; transform: translateY(-24px); } to { opacity: 1; transform: translateY(0); } }

.pill-nav-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    background: rgba(40, 14, 16, 0.82);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1.5px solid rgba(255, 60, 60, 0.5);
    border-radius: 999px;
    box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.5),
        0 12px 40px -12px rgba(255, 40, 40, 0.75),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.nav-logo { display: flex; align-items: center; text-decoration: none; padding-left: 4px; }

.nav-logo img {
    height: 32px;
    width: auto;
    object-fit: contain;
    border-radius: 8px;
    background: white;
    padding: 3px;
    box-shadow: 0 0 0 1px rgba(255, 60, 60, 0.45);
}

.nav-links { display: flex; gap: 2px; margin-left: auto; align-items: center; }

.nav-link {
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.78);
    font-size: 11.5px;
    font-weight: 700;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    white-space: nowrap;
}
.nav-link:hover { color: #fff; background: rgba(192, 0, 0, 0.6); transform: translateY(-1px); }

.nav-progress {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-radius: 999px;
    background: rgba(192, 0, 0, 0.35);
    font-size: 11px;
    font-weight: 700;
    color: #ffb0b0;
    font-family: var(--font-mono);
    border: 1px solid rgba(255, 60, 60, 0.45);
}

.nav-progress-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #ff2b2b;
    box-shadow: 0 0 10px rgba(255, 43, 43, 1);
    animation: dotPulse 2s ease-in-out infinite;
}

@keyframes dotPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.25); opacity: 0.7; } }

.lang-select {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 60, 60, 0.5);
    font-size: 11px;
    font-weight: 700;
    background: rgba(40, 14, 16, 0.75);
    color: #ffb0b0;
    cursor: pointer;
    font-family: var(--font-body);
}
.lang-select:hover { border-color: var(--red-bright); color: #fff; }
.lang-select option { background: #1a0a0a; color: #fff; }

@media (max-width: 700px) { .nav-links { display: none; } }

/* ═══ HERO ═══ */
.hero { position: relative; padding: 60px 20px 48px; text-align: center; }

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    margin-bottom: 22px;
    border-radius: 999px;
    background: rgba(30, 12, 12, 0.75);
    border: 1px solid rgba(255, 60, 60, 0.45);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: #ff9090;
    box-shadow: 0 6px 24px -8px rgba(255, 40, 40, 0.8);
    animation: badgeFloat 4s ease-in-out infinite;
}

@keyframes badgeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

.hero-badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #ff2b2b;
    box-shadow: 0 0 0 0 rgba(255, 43, 43, 0.7);
    animation: heroDot 2s ease-in-out infinite;
}

@keyframes heroDot {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 43, 43, 0.7); }
    50% { box-shadow: 0 0 0 8px rgba(255, 43, 43, 0); }
}

.hero-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 6.5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.1;
    margin-bottom: 16px;
    color: #ffffff;
    text-shadow: 0 4px 30px rgba(255, 40, 40, 0.7);
}

.hero-title .split-char {
    background: linear-gradient(135deg, #ffffff 0%, #ffd0d0 40%, #ffffff 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation:
        sfFlip 0.72s cubic-bezier(0.34, 1.4, 0.64, 1) backwards,
        titleShine 6s ease-in-out 1.2s infinite;
}

@keyframes titleShine { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

.hero-subtitle { font-size: 15px; font-weight: 500; color: rgba(255, 255, 255, 0.78); }

.hero-wave {
    display: block;
    width: 90px;
    height: 4px;
    margin: 26px auto 0;
    border-radius: 4px;
    background: linear-gradient(90deg, transparent, var(--red-bright), transparent);
    position: relative;
    overflow: hidden;
}
.hero-wave::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, #fff, transparent);
    animation: waveSlide 2.6s ease-in-out infinite;
}
@keyframes waveSlide { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

/* ═══ CARD ═══ */
.container { max-width: 920px; margin: 0 auto 25px; padding: 0 15px; }

.card-electric {
    position: relative;
    padding: 34px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow:
        0 1px 2px rgba(20, 10, 10, 0.06),
        0 30px 100px -30px rgba(255, 40, 40, 0.75);
}

/* ═══ MAGIC BENTO ═══ */
.bento-box { position: relative; overflow: hidden; isolation: isolate; }
.bento-box > *:not(.bento-spotlight):not(.bento-border-glow) { position: relative; z-index: 3; }

.bento-spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(480px circle at var(--mx, 50%) var(--my, 50%),
        rgba(255, 60, 60, 0.22) 0%, rgba(192, 0, 0, 0.08) 25%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 1;
}
.bento-box:hover .bento-spotlight { opacity: 1; }

.bento-border-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%),
        rgba(255, 60, 60, 0.95) 0%, rgba(192, 0, 0, 0.5) 25%, transparent 50%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 2;
}
.bento-box:hover .bento-border-glow { opacity: 1; }

.bento-star {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #ff5c5c;
    box-shadow: 0 0 8px #ff2b2b, 0 0 16px rgba(255, 60, 60, 0.7);
    pointer-events: none;
    z-index: 4;
    transform: translate(-50%, -50%);
    animation: bentoStarFly 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes bentoStarFly {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0); }
    25% { opacity: 1; transform: translate(-50%, -50%) scale(1.6); }
    100% {
        opacity: 0;
        transform: translate(calc(-50% + var(--dx, 0px)), calc(-50% + var(--dy, 0px))) scale(0.3);
    }
}

.bento-ripple {
    position: absolute;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 60, 60, 0.5) 0%, transparent 70%);
    border: 2px solid rgba(255, 60, 60, 0.6);
    transform: translate(-50%, -50%) scale(0);
    animation: bentoRippleOut 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    pointer-events: none;
    z-index: 5;
}

@keyframes bentoRippleOut {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(24); opacity: 0; }
}

/* ═══ WELCOME (bento) ═══ */
.welcome {
    background: linear-gradient(135deg, var(--red-tint) 0%, #fff 100%);
    border: 1px solid var(--red-tint-2);
    padding: 22px 24px;
    margin-bottom: 24px;
    border-radius: 14px;
}

.welcome::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 5px;
    background: linear-gradient(180deg, var(--red), var(--red-dark));
    z-index: 4;
    border-radius: 14px 0 0 14px;
}

.welcome-title {
    color: var(--red);
    font-family: var(--font-display);
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
}

.welcome-body { color: var(--ink-soft); line-height: 1.65; font-size: 10pt; }

/* ═══ HOW IT WORKS ═══ */
.how {
    background: rgba(255, 255, 255, 0.7);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 22px 24px;
    margin-bottom: 30px;
}

.how-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 16px;
}

.how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.how-step {
    position: relative;
    padding: 16px 16px 16px 50px;
    background: #fff;
    border: 1px solid var(--red-tint-2);
    border-radius: 12px;
    font-size: 9.5pt;
    line-height: 1.55;
    color: var(--ink-soft);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s;
    opacity: 0;
    transform: translateX(-18px);
}

.how-step.in-view { animation: stepSlideIn 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
@keyframes stepSlideIn { to { opacity: 1; transform: translateX(0); } }
.how-step:nth-child(1).in-view { animation-delay: 0.15s; }
.how-step:nth-child(2).in-view { animation-delay: 0.3s; }
.how-step:nth-child(3).in-view { animation-delay: 0.45s; }

.how-step:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -16px rgba(122, 0, 0, 0.45); }

.how-step strong {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 10.5pt;
    margin-bottom: 4px;
}

.how-step .step-desc { display: block; }

.how-step::before {
    content: attr(data-step);
    position: absolute;
    left: 14px;
    top: 16px;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    color: white;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: stepPulse 3s ease-in-out infinite;
}

.how-step:nth-child(2)::before { animation-delay: 0.4s; }
.how-step:nth-child(3)::before { animation-delay: 0.8s; }
@keyframes stepPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(192, 0, 0, 0.5); } 50% { box-shadow: 0 0 0 8px rgba(192, 0, 0, 0); } }

@media (max-width: 700px) { .how-steps { grid-template-columns: 1fr; } }

/* ═══ SECTION TITLES ═══ */
.section-title {
    position: relative;
    display: block;
    color: var(--red);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.2px;
    line-height: 1.35;
    margin: 40px 0 8px;
    padding: 0 0 12px 24px;
    border-bottom: 1px solid var(--line);
}

.section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 9px; height: 9px;
    border-radius: 3px;
    background: var(--red);
    box-shadow: 0 0 0 4px var(--red-tint-2);
    animation: titleDotPulse 2.4s ease-in-out infinite;
}

@keyframes titleDotPulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--red-tint-2); }
    50% { box-shadow: 0 0 0 8px rgba(252, 228, 228, 0.3); }
}

.section-title:first-of-type { margin-top: 0; }

.section-subtitle {
    color: var(--ink-soft);
    margin-bottom: 24px;
    line-height: 1.6;
    font-size: 10pt;
}

/* ═══ FIELDS ═══ */
.field {
    margin-bottom: 18px;
    position: relative;
    scroll-margin-top: 110px;
}

.field label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.4;
    font-size: 9.6pt;
    color: var(--ink);
    transition: color 0.25s ease;
}

.field:focus-within label { color: var(--red); }
.required { color: var(--red); font-weight: 700; }

.field input, .field select, .field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #d8cfcf;
    border-radius: 10px;
    background: rgba(255, 253, 253, 0.9);
    font-family: var(--font-body);
    font-size: 10pt;
    color: var(--ink);
    transition: border-color 0.2s ease, box-shadow 0.25s ease, background 0.2s ease;
}

.field input:hover, .field select:hover, .field textarea:hover { border-color: #c7abab; }
.field textarea { min-height: 75px; resize: vertical; }

.field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--red);
    background: white;
    box-shadow: 0 0 0 4px var(--red-tint-2);
}

.field.field-valid::before {
    content: "✓";
    position: absolute;
    right: 12px;
    bottom: 14px;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--green);
    color: white;
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: tickIn 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 2;
    box-shadow: 0 4px 10px -2px rgba(22, 163, 74, 0.5);
}

@keyframes tickIn {
    from { transform: scale(0) rotate(-90deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
}

.field.field-invalid input, .field.field-invalid select, .field.field-invalid textarea {
    border-color: var(--red);
    background: #fdf1f1;
    animation: invalidShake 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.field.field-invalid label { color: var(--red); }

@keyframes invalidShake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
}

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
.full { grid-column: 1 / -1; }

/* ═══ NOMINEES ═══ */
.nominee-card {
    border: 1.5px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 18px;
    background: linear-gradient(180deg, #fcfafa 0%, #faf6f6 100%);
    position: relative;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    animation: nomineeIn 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes nomineeIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.nominee-card:hover { box-shadow: 0 12px 28px -16px rgba(90, 0, 0, 0.4); transform: translateY(-1px); }

.nominee-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }

.nominee-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--red);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
}

.nominee-title::before {
    content: "";
    width: 26px; height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    flex-shrink: 0;
}

.remove-nominee {
    background: white;
    color: var(--ink-soft);
    border: 1.5px solid #d8cfcf;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
}

.remove-nominee:hover { background: #f8d7da; color: #842029; border-color: #842029; }

.add-nominee {
    background: white;
    color: var(--red);
    border: 1.5px dashed var(--red);
    padding: 12px 18px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 20px;
    transition: all 0.25s ease;
    width: 100%;
    font-family: var(--font-body);
    font-size: 10pt;
}

.add-nominee:hover {
    background: var(--red-tint);
    border-style: solid;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -10px rgba(122, 0, 0, 0.5);
}

.nominee-age { background: #f2ecec !important; color: var(--ink-soft); }

/* ═══ DECLARATION ═══ */
.declaration {
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 16px 17px;
    margin-bottom: 12px;
    background: #fcfafa;
    transition: all 0.25s ease;
    cursor: pointer;
    scroll-margin-top: 110px;
}

.declaration:hover { border-color: #c7abab; transform: translateX(2px); }

.declaration:has(input:checked) {
    border-color: var(--red);
    background: var(--red-tint);
    box-shadow: 0 0 0 3px var(--red-tint-2);
    transform: translateX(4px);
}

.declaration.declaration-invalid {
    border-color: var(--red);
    background: #fdf1f1;
    animation: invalidShake 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.declaration label { display: flex; align-items: flex-start; gap: 11px; line-height: 1.55; cursor: pointer; }
.declaration input { margin-top: 3px; flex-shrink: 0; accent-color: var(--red); width: 16px; height: 16px; }
.declaration-place-date { margin-top: 25px; padding-top: 5px; }

/* ═══ ACTION NOTE (bento) ═══ */
.action-note {
    background: linear-gradient(135deg, #fff8e1 0%, #fffbf0 100%);
    border: 1px solid #f0d98a;
    border-radius: 14px;
    padding: 20px 24px;
    margin-top: 34px;
    font-size: 9.8pt;
    line-height: 1.7;
    color: var(--ink-soft);
}

.action-note-title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 10px;
}

.action-note ul { margin: 6px 0 0 22px; padding: 0; list-style: none; }
.action-note li { margin-bottom: 6px; position: relative; padding-left: 4px; }
.action-note li::before {
    content: "▸";
    position: absolute;
    left: -18px;
    color: var(--red);
    font-weight: 800;
}

/* ═══ BUTTONS ═══ */
.actions-wrapper {
    display: flex;
    gap: 14px;
    margin-top: 28px;
    flex-wrap: wrap;
    align-items: stretch;
}

.secondary-actions { display: flex; gap: 10px; flex-shrink: 0; }

.action-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 14px;
    border: 1.5px solid rgba(192, 0, 0, 0.18);
    background: linear-gradient(180deg, #ffffff 0%, #faf6f6 100%);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 1px 2px rgba(20, 10, 10, 0.05), 0 6px 18px -10px rgba(122, 0, 0, 0.3);
    white-space: nowrap;
}

.action-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(192, 0, 0, 0.4);
    box-shadow: 0 1px 2px rgba(20, 10, 10, 0.06), 0 14px 30px -12px rgba(122, 0, 0, 0.5);
    color: var(--red);
}

.action-btn svg { width: 16px; height: 16px; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
.action-btn:hover svg { transform: scale(1.15) rotate(-8deg); }

.btn-generate {
    position: relative;
    flex: 1;
    min-width: 240px;
    padding: 18px 32px;
    border: none;
    border-radius: 16px;
    background: linear-gradient(135deg, #c00000 0%, #7a0000 100%);
    color: white;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.3px;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.2) inset,
        0 -2px 8px rgba(74, 0, 0, 0.5) inset,
        0 12px 30px -10px rgba(255, 40, 40, 0.8);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
    animation: btnBreathe 3.4s ease-in-out infinite;
}

@keyframes btnBreathe {
    0%, 100% { box-shadow: 0 1px 0 rgba(255,255,255,0.2) inset, 0 -2px 8px rgba(74,0,0,0.5) inset, 0 12px 30px -10px rgba(255,40,40,0.8), 0 0 0 0 rgba(255,40,40,0.5); }
    50% { box-shadow: 0 1px 0 rgba(255,255,255,0.2) inset, 0 -2px 8px rgba(74,0,0,0.5) inset, 0 18px 42px -10px rgba(255,40,40,1), 0 0 0 10px rgba(255,40,40,0); }
}

.btn-generate:hover {
    transform: translateY(-3px) scale(1.01);
    animation-play-state: paused;
}

.btn-generate .star {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 8px white, 0 0 16px rgba(255, 255, 255, 0.9);
    pointer-events: none;
    opacity: 0;
    animation: starOrbit 3.6s ease-in-out infinite;
}

.btn-generate .star:nth-child(1) { animation-delay: 0s; top: 25%; left: 12%; }
.btn-generate .star:nth-child(2) { animation-delay: 0.9s; top: 65%; left: 88%; }
.btn-generate .star:nth-child(3) { animation-delay: 1.8s; top: 15%; left: 80%; }
.btn-generate .star:nth-child(4) { animation-delay: 2.7s; top: 82%; left: 18%; }

@keyframes starOrbit { 0%, 100% { opacity: 0; transform: scale(0.5); } 50% { opacity: 1; transform: scale(1.6); } }

.btn-generate::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.45) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.btn-generate:hover::before { transform: translateX(100%); }

.btn-generate .btn-text {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
}

.btn-generate svg { width: 18px; height: 18px; transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
.btn-generate:hover svg { transform: translateY(3px); }

/* ═══ STATUS / DRAWER / LOADER / CONFETTI ═══ */
.status {
    display: none;
    margin-top: 18px;
    padding: 13px 16px;
    border-radius: 12px;
    font-weight: 500;
}
.status.success { display: block; background: #e7f6ec; color: #0f5132; border: 1px solid #b6e3c4; }
.status.error { display: block; background: #fbe9ea; color: #842029; border: 1px solid #f0b8bc; }
.status.info { display: block; background: #e6f6fb; color: #055160; border: 1px solid #b6e6f2; }

.hidden { display: none !important; }

.error-drawer {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(140%);
    z-index: 9997;
    width: calc(100% - 32px);
    max-width: 560px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 2px 6px rgba(20, 10, 10, 0.08), 0 24px 60px -20px rgba(255, 40, 40, 0.7);
    border: 1.5px solid var(--red-tint-2);
    overflow: hidden;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
}

.error-drawer.visible { transform: translateX(-50%) translateY(0); pointer-events: auto; }

.error-drawer-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: linear-gradient(135deg, #fdf1f1 0%, #fff 100%);
    border-bottom: 1px solid var(--red-tint-2);
}

.error-drawer-icon {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
}

.error-drawer-title { flex: 1; font-family: var(--font-display); font-size: 14px; font-weight: 700; }
.error-drawer-title small { display: block; font-family: var(--font-body); font-size: 11.5px; font-weight: 500; color: var(--ink-soft); margin-top: 2px; }

.error-drawer-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: none;
    background: white;
    color: var(--ink-soft);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
}

.error-drawer-body { max-height: 44vh; overflow-y: auto; padding: 8px 0; }

.error-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    cursor: pointer;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    font-family: var(--font-body);
    font-size: 10pt;
    color: var(--ink);
    border-bottom: 1px solid #f5eeee;
}

.error-item:last-child { border-bottom: none; }
.error-item:hover { background: var(--red-tint); }

.error-item-num {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--red-tint-2);
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    font-family: var(--font-mono);
    flex-shrink: 0;
}

.error-item-label { flex: 1; font-weight: 600; }
.error-item-arrow { color: var(--red); font-size: 16px; opacity: 0.5; }

.error-drawer-footer {
    padding: 12px 20px;
    background: #faf6f4;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 10px;
}

.error-drawer-btn {
    flex: 1;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1.5px solid var(--red);
    background: white;
    color: var(--red);
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
}

.error-drawer-btn.primary { background: linear-gradient(135deg, var(--red), var(--red-dark)); color: white; border-color: transparent; }

.loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(20, 8, 10, 0.88);
    backdrop-filter: blur(12px);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 26px;
}

.loader-overlay.visible { display: flex; }

.lattice { display: grid; grid-template-columns: repeat(3, 14px); gap: 5px; }

.lattice-cell {
    width: 14px; height: 14px;
    border-radius: 4px;
    background: var(--red-bright);
    opacity: 0.15;
    animation: latticeWave 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.lattice-cell:nth-child(1) { animation-delay: 0s; }
.lattice-cell:nth-child(2) { animation-delay: 0.1s; }
.lattice-cell:nth-child(3) { animation-delay: 0.2s; }
.lattice-cell:nth-child(4) { animation-delay: 0.3s; }
.lattice-cell:nth-child(5) { animation-delay: 0.4s; }
.lattice-cell:nth-child(6) { animation-delay: 0.5s; }
.lattice-cell:nth-child(7) { animation-delay: 0.6s; }
.lattice-cell:nth-child(8) { animation-delay: 0.7s; }
.lattice-cell:nth-child(9) { animation-delay: 0.8s; }

@keyframes latticeWave { 0%, 70%, 100% { opacity: 0.15; transform: scale(1); } 35% { opacity: 1; transform: scale(1.3); } }

.loader-text { font-family: var(--font-display); font-size: 14px; font-weight: 700; color: #fff; }
.loader-text small { display: block; font-family: var(--font-body); font-weight: 500; font-size: 12px; color: rgba(255, 255, 255, 0.6); margin-top: 4px; }

.confetti-piece {
    position: fixed;
    top: -20px;
    width: 9px; height: 15px;
    z-index: 9999;
    pointer-events: none;
    animation: confettiFall linear forwards;
    border-radius: 2px;
}

@keyframes confettiFall {
    0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
    100% { transform: translateY(105vh) rotate(720deg) scale(0.6); opacity: 0; }
}

.footer {
    text-align: center;
    color: rgba(255, 200, 200, 0.5);
    font-size: 11px;
    padding: 20px 0 44px;
}

.footer-logo { display: block; height: 34px; width: auto; margin: 0 auto 12px; opacity: 0.95; }

.footer::before {
    content: "";
    display: block;
    width: 46px;
    height: 3px;
    margin: 0 auto 16px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--red), var(--red-bright));
}

.privacy-note { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 10.5px; }

@media (max-width: 700px) {
    .hero { padding: 40px 18px 32px; }
    .grid { grid-template-columns: 1fr; }
    .full { grid-column: auto; }
    .card-electric { padding: 22px 18px; border-radius: 16px; }
    .actions-wrapper { flex-direction: column; }
    .secondary-actions { width: 100%; }
    .action-btn { flex: 1; justify-content: center; }
    .btn-generate { min-width: 100%; }
}
</style>
</head>

