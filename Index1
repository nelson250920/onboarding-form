    <span class="hero-wave"></span>
</header>

<div class="container">
<div class="card-electric">

<div class="welcome bento-box">
    <div class="bento-spotlight" aria-hidden="true"></div>
    <div class="bento-border-glow" aria-hidden="true"></div>
    <h2 class="welcome-title" data-split="chars" data-delay="40" data-i18n="welcomeTitle">Welcome to Team Red</h2>
