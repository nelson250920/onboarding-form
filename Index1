            <div class="field"><label>Percentage ${requiredMark(n)}</label><input type="number" id="nominee${n}_percentage" min="1" max="100" ${requiredAttr(n)}></div>
        </div>`;
    document.getElementById("nomineeContainer").appendChild(div);
    document.getElementById("addNomineeButton").style.display = nomineeCount >= 4 ? "none" : "";
    attachValidationListeners(div);
    updateProgress();
}

function removeNominee(n) {
    if (n === 1) return;
    if (!confirm("Remove Nominee " + n + "?")) return;
    renderNominees(getNominees().filter((_, i) => (i + 1) !== n));
}

function renderNominees(data) {
    document.getElementById("nomineeContainer").innerHTML = "";
    nomineeCount = 0;
    const list = (Array.isArray(data) && data.length) ? data.slice(0, 4) : [{}];
    list.forEach(function (ni) {
        addNominee();
        const n = nomineeCount;
        setValue("nominee" + n + "_name", ni.name);
        setValue("nominee" + n + "_address", ni.address);
        setValue("nominee" + n + "_relation", ni.relation);
        setValue("nominee" + n + "_aadhaar", ni.aadhaar);
        setValue("nominee" + n + "_dob", ni.dob);
        setValue("nominee" + n + "_percentage", ni.percentage);
        calculateNomineeAge(n);
    });
    updateNomineeRelations();
    updateProgress();
}

function calculateNomineeAge(n) {
    const dob = document.getElementById("nominee" + n + "_dob").value;
    const ageField = document.getElementById("nominee" + n + "_age");
    if (!dob) { ageField.value = ""; return; }
    const bd = new Date(dob + "T00:00:00"), today = new Date();
    if (bd > today) { ageField.value = ""; return; }
    let age = today.getFullYear() - bd.getFullYear();
    const m = today.getMonth() - bd.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < bd.getDate())) age--;
    ageField.value = age >= 0 ? age : "";
}

function digitsOnly(i) { i.value = i.value.replace(/\D/g, ""); }

function getNominees() {
    const out = [];
    for (let i = 1; i <= nomineeCount; i++) {
        if (!document.getElementById("nominee-" + i)) continue;
