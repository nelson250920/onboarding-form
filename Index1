function fireConfetti() {
    if (prefersReducedMotion) return;
    const colors = ["#c00000","#7a0000","#ff2b2b","#16a34a","#fbbf24","#f97316"];
    for (let i = 0; i < 60; i++) {
        const p = document.createElement("div");
