const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function getDraftKey() {
    let sid = sessionStorage.getItem("tr_session_id");
    if (!sid) { sid = "s" + Math.random().toString(36).slice(2, 12) + Date.now(); sessionStorage.setItem("tr_session_id", sid); }
    return DRAFT_NAMESPACE + ":" + sid;
