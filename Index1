/* SPLIT FLAP */
function splitElement(el) {
    const mode = el.dataset.split;
    const delay = parseInt(el.dataset.delay || "40", 10);
    const start = parseInt(el.dataset.start || "0", 10);

    /* ─── LINES MODE: children ARE the content, do NOT wipe them ─── */
    if (mode === "lines") {
        Array.from(el.children).forEach(function (li, i) {
            li.classList.add("split-line");
            li.style.animationDelay = (start + i * delay) + "ms";
        });
        el.classList.add("split-lines");
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                el.classList.add("animate");
            });
        });
        el.dataset.splitDone = "1";
        return;
    }

    /* ─── CHARS / WORDS MODE: wipe and rebuild from text ─── */
    const text = (el.textContent || "").replace(/\s+/g, " ").trim();
    if (!text) return;

    el.setAttribute("aria-label", text);
    el.textContent = "";

    if (mode === "chars") {
        const wrap = document.createElement("span");
        wrap.className = "split-chars";
        for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            const s = document.createElement("span");
            s.className = "split-char";
            if (ch === " ") {
                s.setAttribute("data-space", "1");
                s.innerHTML = "&nbsp;";
            } else {
                s.textContent = ch;
            }
            s.style.animationDelay = (start + i * delay) + "ms";
            wrap.appendChild(s);
        }
        el.appendChild(wrap);
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                wrap.classList.add("animate");
            });
        });
    } else if (mode === "words") {
        const wrap = document.createElement("span");
        wrap.className = "split-words";
        const words = text.split(" ");
        words.forEach(function (w, i) {
            const s = document.createElement("span");
            s.className = "split-word";
            s.textContent = w;
            s.style.animationDelay = (start + i * delay) + "ms";
            wrap.appendChild(s);
            if (i < words.length - 1) wrap.appendChild(document.createTextNode(" "));
        });
        el.appendChild(wrap);
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                wrap.classList.add("animate");
            });
        });
    }

    el.dataset.splitDone = "1";
}

function initSplitAnimations() {
    const els = document.querySelectorAll("[data-split]");
    if (!els.length) return;
    if (prefersReducedMotion) { els.forEach(el => el.classList.add("animate")); return; }
    if (!("IntersectionObserver" in window)) { els.forEach(splitElement); return; }

    const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            const el = e.target;
            if (!el.dataset.splitDone) splitElement(el);
            obs.unobserve(el);
        });
    }, { threshold: 0 });

    els.forEach(el => obs.observe(el));

    setTimeout(function () {
        els.forEach(function (el) {
            if (el.dataset.splitDone) return;
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) splitElement(el);
        });
    }, 2500);
}

function initHowSteps() {
    const steps = document.querySelectorAll(".how-step");
    if (!steps.length) return;
    if (prefersReducedMotion) { steps.forEach(s => s.classList.add("in-view")); return; }
    const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in-view"); obs.unobserve(e.target); }
        });
    }, { threshold: 0.2 });
    steps.forEach(s => obs.observe(s));
}

/* BENTO */
function initBentoBoxes() {
    if (prefersReducedMotion) return;
    document.querySelectorAll(".bento-box").forEach(function (box) {
        box.addEventListener("mousemove", function (e) {
            const r = box.getBoundingClientRect();
            const x = e.clientX - r.left, y = e.clientY - r.top;
            box.style.setProperty("--mx", x + "px");
            box.style.setProperty("--my", y + "px");
            if (Math.random() < 0.2) spawnBentoStar(box, x, y);
        });
        box.addEventListener("click", function (e) {
            const r = box.getBoundingClientRect();
            spawnBentoRipple(box, e.clientX - r.left, e.clientY - r.top);
        });
    });
}

function spawnBentoStar(box, x, y) {
    const s = document.createElement("span");
    s.className = "bento-star";
    s.style.left = x + "px";
    s.style.top = y + "px";
    const a = Math.random() * Math.PI * 2, d = 12 + Math.random() * 42;
    s.style.setProperty("--dx", (Math.cos(a) * d).toFixed(1) + "px");
    s.style.setProperty("--dy", (Math.sin(a) * d).toFixed(1) + "px");
    box.appendChild(s);
    setTimeout(() => s.remove(), 1200);
}

function spawnBentoRipple(box, x, y) {
    const r = document.createElement("span");
    r.className = "bento-ripple";
    r.style.left = x + "px";
    r.style.top = y + "px";
    box.appendChild(r);
    setTimeout(() => r.remove(), 1100);
}

